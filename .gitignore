# ============================================================
# Python
# ============================================================

# 字节码
*.pyc
*.pyo
*.pyd
.Python
**/__pycache__/
*.egg-info/
dist/
build/

# 虚拟环境
venv/
.venv/

# ============================================================
# 测试 / 覆盖率
# ============================================================

.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.tox/

# ============================================================
# IDE / 编辑器
# ============================================================

.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# 项目生成物（不提交）
# ============================================================

# 配置文件（使用 config/settings.yml.template）
config/settings.yml

# 输入文档（不提交样本 PDF）
input/base/
input/compare/

# 输出报告（每次比对生成）
versions/
specs/

# 日志
logs/

# 临时 / 调试
tmp/
*.log

# 本地临时脚本（调试用，前缀 _ 或 check_）
# 排障期间产生的大量临时探针脚本统一忽略，避免误提交
_*.py
check_*.py
verify.ps1
tests/debug_differ.py

# ============================================================
# 三方依赖（vendored）
# ============================================================

# vendor/ 目录由 git 跟踪（其中 __pycache__ 需忽略）
vendor/__pycache__/
